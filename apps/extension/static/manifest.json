{
  "manifest_version": 3,
  "name": "CrowdShield Guard",
  "short_name": "CrowdShield",
  "description": "Check scam messages without copying anything: snip any part of the screen, and get warnings inside WhatsApp Web, Telegram Web and Gmail.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": { "default_popup": "popup.html", "default_title": "CrowdShield Guard" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://crowdshield.184-197-8-50.sslip.io/*", "http://localhost:4020/*"],
  "optional_host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://mail.google.com/*"
  ],
  "commands": {
    "snip": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Snip an area of the screen and check it"
    }
  },
  "minimum_chrome_version": "116"
}
