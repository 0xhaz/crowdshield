{
  "name": "@crowdshield/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@crowdshield/contracts": "workspace:*",
    "@crowdshield/db": "workspace:*",
    "@crowdshield/i18n": "workspace:*",
    "@crowdshield/normalise": "workspace:*",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7",
    "@aws-sdk/client-s3": "3.1147.0"
  }
}
