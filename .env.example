# Copy to .env. Local dev values only; never commit real secrets.

# ---------- infrastructure (docker-compose.yml) ----------
DATABASE_URL=postgres://crowdshield:crowdshield@localhost:5442/crowdshield
DATABASE_URL_TEST=postgres://crowdshield:crowdshield@localhost:5442/crowdshield_test
REDIS_URL=redis://localhost:6389
S3_ENDPOINT=http://localhost:9020
S3_REGION=ap-southeast-5
S3_ACCESS_KEY=crowdshield
S3_SECRET_KEY=crowdshield-dev-secret
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_INVOICES=invoices

# ---------- identifier protection (stand-ins for KMS) ----------
# HMAC pepper for lookup_hash and key for pgp_sym_encrypt(value_enc). Generate with: openssl rand -hex 32
IDENTIFIER_HMAC_PEPPER=
IDENTIFIER_ENC_KEY=
# Password for all seeded demo logins (default: crowdshield-demo)
SEED_DEMO_PASSWORD=

# ---------- service URLs ----------
API_URL=http://localhost:4020
ML_GATEWAY_URL=http://localhost:8020
# Internal key the API and bot send to the ML gateway (X-Internal-Key)
ML_API_KEY=
WEB_URL=http://localhost:3020
# Public HTTPS tunnel (cloudflared / ngrok) pointing at the bot service, for webhooks
PUBLIC_BOT_URL=

# ---------- auth (web) ----------
AUTH_SECRET=
JWT_SECRET=
# Service key the bot sends as X-Api-Key
BOT_API_KEY=

# ---------- Nebius Token Factory (OpenAI-compatible) ----------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL_TEXT=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
NEBIUS_MODEL_EMBEDDING=Qwen/Qwen3-Embedding-8B

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (test number) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=

# ---------- Tavily (live web intelligence, techstacks_7 §4) ----------
TAVILY_API_KEY=
